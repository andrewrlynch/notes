	month = jun,
	year = {2022},
	keywords = {Breast cancer, DNA sequencing},
	pages = {850--860},
	file = {Lips et al. - 2022 - Genomic analysis defines clonal relationships of ductal carcinoma in situ and recurrent invasive bre.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Lips et al. - 2022 - Genomic analysis defines clonal relationships of ductal carcinoma in situ and recurrent invasive bre.pdf:application/pdf;Snapshot:/Users/andrew/Zotero/storage/QI57RUUN/s41588-022-01082-3.html:text/html},
