@article{hoyt_chromosome_1990,
	title = {Chromosome instability mutants of {Saccharomyces} cerevisiae that are defective in microtubule-mediated processes.},
	volume = {10},
	issn = {0270-7306},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC360730/},
	abstract = {By using a multiply marked supernumerary chromosome III as an indicator, we isolated mutants of Saccharomyces cerevisiae that display increased rates of chromosome loss. In addition to mutations in the tubulin-encoding TUB genes, we found mutations in the CIN1, CIN2, and CIN4 genes. These genes have been defined independently by mutations causing benomyl supersensitivity and are distinct from other known yeast genes that affect chromosome segregation. Detailed phenotypic characterization of cin mutants revealed several other phenotypes similar to those of tub mutants. Null alleles of these genes caused cold sensitivity for viability. At 11 degrees C, cin mutants arrest at the mitosis stage of their cell cycle because of loss of most microtubule structure. cin1, cin2, and cin4 mutations also cause defects in two other microtubule-mediated processes, nuclear migration and nuclear fusion (karyogamy). Overproduction of the CIN1 gene product was found to cause the same phenotype as loss of function, supersensitivity to benomyl. Our findings suggest that the CIN1, CIN2, and CIN4 proteins contribute to microtubule stability either by regulating the activity of a yeast microtubule component or as structural components of microtubules.},
	number = {1},
	urldate = {2023-02-16},
	journal = {Molecular and Cellular Biology},
	author = {Hoyt, M A and Stearns, T and Botstein, D},
	month = jan,
	year = {1990},
	pmid = {2403635},
	pmcid = {PMC360730},
	pages = {223--234},
	file = {Hoyt et al. - 1990 - Chromosome instability mutants of Saccharomyces cerevisiae that are defective in microtubule-mediate.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Hoyt et al. - 1990 - Chromosome instability mutants of Saccharomyces cerevisiae that are defective in microtubule-mediate.pdf:application/pdf},
}

