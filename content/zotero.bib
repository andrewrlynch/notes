@article{pei_spatial_2025,
	title = {Spatial mapping of transcriptomic plasticity in metastatic pancreatic cancer},
	copyright = {2025 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-025-08927-x},
	doi = {10.1038/s41586-025-08927-x},
	abstract = {Patients with treatment-refractory pancreatic cancer often succumb to systemic metastases1–3; however, the transcriptomic heterogeneity that underlies therapeutic recalcitrance remains understudied, particularly in a spatial context. Here we construct high-resolution maps of lineage states, clonal architecture and the tumour microenvironment (TME) using spatially resolved transcriptomics from 55 samples of primary tumour and metastases (liver, lung and peritoneum) collected from rapid autopsies of 13 people. We observe discernible transcriptomic shifts in cancer-cell lineage states as tumours transition from primary sites to organ-specific metastases, with the most pronounced intra-patient distinctions between liver and lung. Phylogenetic trees constructed from inferred copy number variations in primary and metastatic loci in each patient highlight diverse patient-specific evolutionary trajectories and clonal dissemination. We show that multiple tumour lineage states co-exist in each tissue, including concurrent metastatic foci in the same organ. Agnostic to tissue site, lineage states correlate with distinct TME features, such as the spatial proximity of TGFB1-expressing myofibroblastic cancer-associated fibroblasts (myCAFs) to aggressive ‘basal-like’ cancer cells, but not to cells in the ‘classical’ or ‘intermediate’ states. These findings were validated through orthogonal and cross-species analyses using mouse tissues and patient-derived organoids. Notably, basal-like cancer cells aligned with myCAFs correlate with plasma-cell exclusion from the tumour milieu, and neighbouring cell analyses suggest that CXCR4–CXCL12 signalling is the underlying basis for observed immune exclusion. Collectively, our findings underscore the profound transcriptomic heterogeneity and microenvironmental dynamics that characterize treatment-refractory pancreatic cancer.},
	language = {en},
	urldate = {2025-04-28},
	journal = {Nature},
	author = {Pei, Guangsheng and Min, Jimin and Rajapakshe, Kimal I. and Branchi, Vittorio and Liu, Yunhe and Selvanesan, Benson Chellakkan and Thege, Fredrik and Sadeghian, Dorsay and Zhang, Daiwei and Cho, Kyung Serk and Chu, Yanshuo and Dai, Enyu and Han, Guangchun and Li, Mingyao and Yee, Cassian and Takahashi, Kazuki and Garg, Bharti and Tiriac, Herve and Bernard, Vincent and Semaan, Alexander and Grem, Jean L. and Caffrey, Thomas C. and Burks, Jared K. and Lowy, Andrew M. and Aguirre, Andrew J. and Grandgenett, Paul M. and Hollingsworth, Michael A. and Guerrero, Paola A. and Wang, Linghua and Maitra, Anirban},
	month = apr,
	year = {2025},
	note = {Publisher: Nature Publishing Group},
	keywords = {Transcriptomics, Metastasis, Pancreatic cancer},
	pages = {1--10},
	file = {Pei et al. - 2025 - Spatial mapping of transcriptomic plasticity in metastatic pancreatic cancer.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Pei et al. - 2025 - Spatial mapping of transcriptomic plasticity in metastatic pancreatic cancer.pdf:application/pdf},
}

