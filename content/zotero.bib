@article{soragni_acquired_2025,
	title = {Acquired resistance in cancer: towards targeted therapeutic strategies},
	volume = {25},
	copyright = {2025 Springer Nature Limited},
	issn = {1474-1768},
	shorttitle = {Acquired resistance in cancer},
	url = {https://www.nature.com/articles/s41568-025-00824-9},
	doi = {10.1038/s41568-025-00824-9},
	abstract = {Development of acquired therapeutic resistance limits the efficacy of cancer treatments and accounts for therapeutic failure in most patients. How resistance arises, varies across cancer types and differs depending on therapeutic modalities is incompletely understood. Novel strategies that address and overcome the various and complex resistance mechanisms necessitate a deep understanding of the underlying dynamics. We are at a crucial time when innovative technologies applied to patient-relevant tumour models have the potential to bridge the gap between fundamental research into mechanisms and timing of acquired resistance and clinical applications that translate these findings into actionable strategies to extend therapy efficacy. Unprecedented spatial and time-resolved high-throughput platforms generate vast amounts of data, from which increasingly complex information can be extracted and analysed through artificial intelligence and machine learning-based approaches. This Roadmap outlines key mechanisms that underlie the acquisition of therapeutic resistance in cancer and explores diverse modelling strategies. Clinically relevant, tractable models of disease and biomarker-driven precision approaches are poised to transform the landscape of acquired therapy resistance in cancer and its clinical management. Here, we propose an integrated strategy that leverages next-generation technologies to dissect the complexities of therapy resistance, shifting the paradigm from reactive management to predictive and proactive prevention.},
	language = {en},
	number = {8},
	urldate = {2025-08-19},
	journal = {Nature Reviews Cancer},
	author = {Soragni, Alice and Knudsen, Erik S. and O’Connor, Thomas N. and Tognon, Cristina E. and Tyner, Jeffrey W. and Gini, Beatrice and Kim, Donghwa and Bivona, Trever G. and Zang, Xingxing and Witkiewicz, Agnieszka K. and Goodrich, David W. and Jiang, Dadi and Gammon, Seth T. and Willey, Christopher D. and Boutros, Paul C. and Sandulache, Vlad C. and Osman, Abdullah A. and Myers, Jeffrey N. and Mehla, Kamiya and Singh, Pankaj K. and Chan, Keith S. and Gao, Hongbo and Marathe, Himangi},
	month = aug,
	year = {2025},
	note = {Publisher: Nature Publishing Group},
	keywords = {Cancer genomics, Cancer models, Cancer therapy},
	pages = {613--633},
	file = {Soragni et al. - 2025 - Acquired resistance in cancer towards targeted therapeutic strategies.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Soragni et al. - 2025 - Acquired resistance in cancer towards targeted therapeutic strategies.pdf:application/pdf},
}

@article{dolan_ageing_2025,
	title = {Ageing, immune fitness and cancer},
	copyright = {2025 Springer Nature Limited},
	issn = {1474-1768},
	url = {https://www.nature.com/articles/s41568-025-00858-z},
	doi = {10.1038/s41568-025-00858-z},
	abstract = {The immune system undergoes substantial changes throughout life, with ageing broadly impacting immune cell composition, function and regenerative capacity. Emerging evidence suggests that age-associated changes in immune fitness — the ability to respond to and eliminate infection, pathogens and malignancy while maintaining self-tolerance — reshape antitumour immunity and influence the efficacy of immunotherapies. Technological advances in high-dimensional immunoprofiling have begun to reveal the complex interplay between ageing, immune fitness and cancer biology, uncovering new therapeutic vulnerabilities and challenges. In this Review, we discuss recent insights derived from age-resolved immunoprofiling of the human tumour microenvironment, how ageing haematopoiesis affects immune cells that contribute to the microenvironment and impact cancer progression, and what is known from preclinical modelling about the functional consequences of immune ageing on tumour control. We further highlight emerging age-stratified analyses of treatment responses, which are beginning to inform hypotheses about how ageing shapes immunotherapy outcomes. Together, these perspectives provide a framework for integrating age as a critical biological variable, underscore the need to consider age in both preclinical models and clinical trial design, and identify key challenges and priorities for the field moving forward.},
	language = {en},
	urldate = {2025-08-19},
	journal = {Nature Reviews Cancer},
	author = {Dolan, Melissa and Libby, Kendra A. and Ringel, Alison E. and van Galen, Peter and McAllister, Sandra S.},
	month = aug,
	year = {2025},
	note = {Publisher: Nature Publishing Group},
	keywords = {Cancer microenvironment, Immunosurveillance},
	pages = {1--25},
	file = {Dolan et al. - 2025 - Ageing, immune fitness and cancer.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Dolan et al. - 2025 - Ageing, immune fitness and cancer.pdf:application/pdf},
}

@article{blomain_evolutionary_2025,
	title = {Evolutionary {Pressures} {Shape} {Undifferentiated} {Pleomorphic} {Sarcoma} {Development} and {Radiotherapy} {Response}},
	volume = {85},
	issn = {0008-5472},
	url = {https://doi.org/10.1158/0008-5472.CAN-24-3281},
	doi = {10.1158/0008-5472.CAN-24-3281},
	abstract = {Radiotherapy is an integral component in the treatment of many types of cancer, with approximately half of patients with cancer receiving radiotherapy. Systemic therapy applies pressure that can select for resistant tumor subpopulations, underscoring the importance of understanding how radiation impacts tumor evolution to improve treatment outcomes. We integrated temporal genomic profiling of 120 spatially distinct tumor regions from 20 patients with undifferentiated pleomorphic sarcomas (UPS), longitudinal circulating tumor DNA analysis, and evolutionary biology computational pipelines to study UPS evolution during tumorigenesis and in response to radiotherapy. Most unirradiated UPSs displayed initial linear evolution, followed by subsequent branching evolution with distinct mutational processes during early and late development. Metrics of genetic divergence between regions provided evidence of strong selection pressures during UPS development that further increased during radiotherapy. Subclone abundance changed after radiotherapy with subclone contraction tied to alterations in calcium signaling, and inhibiting calcium transporters radiosensitized sarcoma cells. Finally, circulating tumor DNA analysis accurately measured subclone abundance and enabled noninvasive monitoring of subclonal changes. These results demonstrate that radiation exerts selective pressures on UPSs and suggest that targeting radioresistant subclonal populations could improve outcomes after radiotherapy.Significance: Radiotherapy mediates tumor evolution by leading to the expansion of resistant subclonal cancer cell populations, indicating that developing approaches to target resistant subclones will be crucial to improve radiotherapy response.},
	number = {6},
	urldate = {2025-07-15},
	journal = {Cancer Research},
	author = {Blomain, Erik S. and Soudi, Shaghayegh and Wang, Ziwei and Somani, Anish and Subramanian, Ajay and Nouth, Serey C.L. and Oladipo, Eniola and New, Christin and Kenney, Deborah E. and Nemat-Gorgani, Neda and Kindler, Thomas and Avedian, Raffi S. and Steffner, Robert J. and Mohler, David G. and Hiniker, Susan M. and Chin, Alexander L. and Kalbasi, Anusha and Binkley, Michael S. and Fried, Marius and Gaida, Matthias M. and van de Rijn, Matt and Moding, Everett J.},
	month = mar,
	year = {2025},
	pages = {1162--1174},
	file = {Blomain et al. - 2025 - Evolutionary Pressures Shape Undifferentiated Pleomorphic Sarcoma Development and Radiotherapy Respo.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Blomain et al. - 2025 - Evolutionary Pressures Shape Undifferentiated Pleomorphic Sarcoma Development and Radiotherapy Respo.pdf:application/pdf;Snapshot:/Users/andrew/Zotero/storage/JHSNBCEE/Evolutionary-Pressures-Shape-Undifferentiated.html:text/html},
}

@article{arora_pan-cancer_2020,
	title = {Pan-cancer identification of clinically relevant genomic subtypes using outcome-weighted integrative clustering},
	volume = {12},
	issn = {1756-994X},
	url = {https://doi.org/10.1186/s13073-020-00804-8},
	doi = {10.1186/s13073-020-00804-8},
	abstract = {Comprehensive molecular profiling has revealed somatic variations in cancer at genomic, epigenomic, transcriptomic, and proteomic levels. The accumulating data has shown clearly that molecular phenotypes of cancer are complex and influenced by a multitude of factors. Conventional unsupervised clustering applied to a large patient population is inevitably driven by the dominant variation from major factors such as cell-of-origin or histology. Translation of these data into clinical relevance requires more effective extraction of information directly associated with patient outcome.},
	number = {1},
	urldate = {2025-07-15},
	journal = {Genome Medicine},
	author = {Arora, Arshi and Olshen, Adam B. and Seshan, Venkatraman E. and Shen, Ronglai},
	month = dec,
	year = {2020},
	keywords = {Integrative clustering, Patient survival, Prognostic molecular stratification, Supervised learning},
	pages = {110},
