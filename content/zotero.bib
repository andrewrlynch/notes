@misc{pradellaImmortalizationTransformationPrimary2023,
	title = {Immortalization and transformation of primary cells mediated by engineered {ecDNAs}},
	copyright = {© 2023, Posted by Cold Spring Harbor Laboratory. The copyright holder for this pre-print is the author. All rights reserved. The material may not be redistributed, re-used or adapted without the author's permission.},
	url = {https://www.biorxiv.org/content/10.1101/2023.06.25.546239v1},
	doi = {10.1101/2023.06.25.546239},
	abstract = {Focal gene amplifications are among the most common cancer-associated mutations, but their evolution and contribution to tumorigenesis have proven challenging to recapitulate in primary cells and model organisms. Here we describe a general approach to engineer large ({\textgreater}1 Mbp) focal amplifications mediated by extrachromosomal circular DNAs (ecDNAs, also known as “double minutes”) in a spatiotemporally controlled manner in cancer cell lines and in primary cells derived from genetically engineered mice. With this strategy, ecDNA formation can be coupled with expression of fluorescent reporters or other selectable markers to enable the identification and tracking of ecDNA-containing cells. We demonstrate the feasibility of this approach by engineering MDM2-containing ecDNAs in near-diploid human cells, showing that GFP expression can be used to track ecDNA dynamics under physiological conditions or in the presence of specific selective pressures. We also apply this approach to generate mice harboring inducible Myc- and Mdm2-containing ecDNAs analogous to those spontaneously occurring in human cancers. We show that the engineered ecDNAs rapidly accumulate in primary cells derived from these animals, promoting proliferation, immortalization, and transformation.},
	language = {en},
	urldate = {2023-10-12},
	publisher = {bioRxiv},
	author = {Pradella, Davide and Zhang, Minsi and Gao, Rui and Yao, Melissa A. and Gluchowska, Katarzyna M. and Florez, Ylenia Cendon and Mishra, Tanmay and Rocca, Gaspare La and Weigl, Moritz and Jiao, Ziqi and Nguyen, Hieu H. M. and Grimm, Felix and Lisi, Marta and Mastroleo, Chiara and Chen, Kevin and Luebeck, Jens and Bafna, Vineet and Antonescu, Cristina R. and Ventura, Andrea},
	month = jun,
	year = {2023},
	note = {Pages: 2023.06.25.546239
Section: New Results},
	file = {Full Text PDF:/Users/andrew/Zotero/storage/ZKKL7SI8/Pradella et al. - 2023 - Immortalization and transformation of primary cell.pdf:application/pdf},
}

