@article{lubs_jr_studies_1966,
	title = {Studies of a glial tumor with multiple minute chromosomes},
	volume = {19},
	issn = {1097-0142},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/1097-0142%28196604%2919%3A4%3C591%3A%3AAID-CNCR2820190419%3E3.0.CO%3B2-5},
	doi = {10.1002/1097-0142(196604)19:4<591::AID-CNCR2820190419>3.0.CO;2-5},
	abstract = {The karyotypes of cells from an untreated medulloblastoma in an 8-year-old girl were characterized by multiple minute chromosomes, an abnormal metacentric and extra chromosomes in group 4–5. These abnormalities permitted identification of tumor cells in the marrow and peripheral blood. Chromosomes in group 4–5 did not demonstrate a late labeling pattern although the patient's lymphocytes and marrow were normal in this respect. This is the first demonstration of a difference in labeling pattern between normal and tumor tissue in man. The minute chromosomes and abnormal metacentric may have resulted from a misdivision of the centromere of 17 or 18. An alternative explanation is that the minute chromosomes were ring chromosomes. In the present tumor there was also evidence for significant biologic variation in karyotype between tumor cells.},
	language = {en},
	number = {4},
	urldate = {2023-02-10},
	journal = {Cancer},
	author = {Lubs Jr., Herbert A. and Salmon, James H. and Flanigan, Stevenson},
	year = {1966},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/1097-0142\%28196604\%2919\%3A4\%3C591\%3A\%3AAID-CNCR2820190419\%3E3.0.CO\%3B2-5},
	pages = {591--599},
	file = {Lubs Jr. et al. - 1966 - Studies of a glial tumor with multiple minute chromosomes.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Lubs Jr. et al. - 1966 - Studies of a glial tumor with multiple minute chromosomes.pdf:application/pdf;Snapshot:/Users/andrew/Zotero/storage/SBUPCTAE/1097-0142(196604)194591AID-CNCR28201904193.0.html:text/html},
