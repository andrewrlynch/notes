	abstract = {Synopsis The same typo of mitotic aberration can be induced by substances of dissimilar chemical constitution. Conversely, in the presence of certain compounds almost every conceivable kind of abnormality of division can be observed. Nevertheless, certain substances in high dilution exert a highly specific action on dividing cells, without appreciably injuring “resting” cells. The phases of mitosis are characterized by fluctuations in the water content of definite regions of the cell. Furthermore, hypotonicity and hypertonicity of the surrounding medium can cause derangements of all phases of mitosis. It is therefore suggested that mitotic aberrations are explicable as the result of chemical and physical reactions bringing about alterations in the normal distribution and interchange of water amongst the protein molecules of different parts of the cell at various stages of division. This conception does not invalidate the probability that in certain instances specific chemical reactions are involved which determine precisely the type of mitotic aberration that will occur.},
	language = {en},
	number = {1},
	urldate = {2023-02-09},
	journal = {Journal of the Royal Microscopical Society},
	author = {Ludford, R. J.},
	year = {1953},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1365-2818.1953.tb02343.x},
	pages = {1--23},
	file = {Snapshot:/Users/andrew/Zotero/storage/W8W6U22C/j.1365-2818.1953.tb02343.html:text/html},
}

