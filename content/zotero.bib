	keywords = {Breast cancer, Genetics research, Cancer genetics},
	pages = {1--10},
	file = {Kim et al. - 2025 - Whole-genome landscapes of 1,364 breast cancers.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Kim et al. - 2025 - Whole-genome landscapes of 1,364 breast cancers.pdf:application/pdf},
