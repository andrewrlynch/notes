	abstract = {High-grade serous ovarian cancer (HGSC) is frequently characterized by homologous recombination (HR) DNA repair deficiency and, while most such tumors are sensitive to initial treatment, acquired resistance is common. We undertook a multiomics approach to interrogate molecular diversity in end-stage disease, using multiple autopsy samples collected from 15 women with HR-deficient HGSC. Patients had polyclonal disease, and several resistance mechanisms were identified within most patients, including reversion mutations and HR restoration by other means. We also observed frequent whole-genome duplication and global changes in immune composition with evidence of immune escape. This analysis highlights diverse evolutionary changes within HGSC that evade therapy and ultimately overwhelm individual patients.},
	language = {en},
	urldate = {2023-03-07},
	journal = {Nature Genetics},
	author = {Burdett, Nikki L. and Willis, Madelynne O. and Alsop, Kathryn and Hunt, Allison L. and Pandey, Ahwan and Hamilton, Phineas T. and Abulez, Tamara and Liu, Xuan and Hoang, Therese and Craig, Stuart and Fereday, Sian and Hendley, Joy and Garsed, Dale W. and Milne, Katy and Kalaria, Shreena and Marshall, Ashley and Hood, Brian L. and Wilson, Katlin N. and Conrads, Kelly A. and Pishas, Kathleen I. and Ananda, Sumitra and Scott, Clare L. and Antill, Yoland and McNally, Orla and Mileshkin, Linda and Hamilton, Anne and Au-Yeung, George and Devereux, Lisa and Thorne, Heather and Bild, Andrea and Bateman, Nicholas W. and Maxwell, G. Larry and Chang, Jeffrey T. and Conrads, Thomas P. and Nelson, Brad H. and Bowtell, David D. L. and Christie, Elizabeth L.},
	month = feb,
