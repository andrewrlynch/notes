	title = {Short- and long-term effects of chromosome mis-segregation and aneuploidy},
	volume = {16},
	issn = {1471-0072},
	url = {http://www.nature.com/articles/nrm4025},
	doi = {10.1038/nrm4025},
	abstract = {Aneuploidy, which results from chromosome mis-segregation, is a hallmark of cancer, but it can also inhibit tumorigenesis. Recent studies on the short- and long-term consequences of aneuploidy, which are caused by gene-specific effects and a stereotypic aneuploidy stress response, provide insights into this contradictory role in tumorigenesis.},
