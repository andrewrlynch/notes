@article{yang_short_2015,
	title = {Short {Proline}-{Substituted} {Muc1} {Mucin} {Peptides} {Can} {Bind} {To} {Mouse} {Muc1} {Monoclonal} {Antibody} as {Revealed} by {STD} {NMR}},
	volume = {14},
	copyright = {All rights reserved},
	url = {https://www.andrewlynch.io/papers/2015-JUCR.pdf},
	abstract = {Many studies on the biological activity of mucin peptides derived from the VNTR domain that are considered as potential cancer vaccines have involved and focused on the immunodominant epitope PDTRP. A short peptide GVTSAPD preceding the main binding epitope and six other substituted peptides were investigated for their ability to bind mouse Muc1 monoclonal antibody (mAb, 6A4) by STD NMR. The Pro6 residue of GVTSAPD was replaced by Asp, Leu, Tyr, Phe, and Trp to obtain the Pro-substituted peptides. A sixth mutant peptide with Ser4 replaced by Asn was also studied for comparison. The results showed that substitution of Ser4 by Asn showed similar binding properties to the native peptide. The Pro-substituted peptides with position 6 occupied by Phe or Trp can bind the mAb, but not those containing Asp or Leu. The Pro-substituted peptides GVTSAFD and GVTSAWD may potentially be useful as additional epitopes toward the development of cancer vaccines.},
	number = {1},
	journal = {Journal of Undergraduate Chemistry Research},
	author = {Yang, Thao and Her, Cheng and Lynch, Andrew R. and White, Ronald J. and Wang, Ming and Westler, William M.},
	year = {2015},
	pages = {5--11},
	file = {Yang et al. - 2015 - Short Proline-Substituted Muc1 Mucin Peptides Can Bind To Mouse Muc1 Monoclonal Antibody as Revealed.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Yang et al. - 2015 - Short Proline-Substituted Muc1 Mucin Peptides Can Bind To Mouse Muc1 Monoclonal Antibody as Revealed.pdf:application/pdf},
}

@article{lynch_quantifying_2022,
	title = {Quantifying chromosomal instability from intratumoral karyotype diversity using agent-based modeling and {Bayesian} inference},
	volume = {11},
	copyright = {All rights reserved},
	issn = {2050-084X},
	url = {https://elifesciences.org/articles/69799},
	doi = {10.7554/eLife.69799},
	abstract = {Chromosomal instability (CIN)—persistent chromosome gain or loss through abnormal mitotic segregation—is a hallmark of cancer that drives aneuploidy. Intrinsic chromosome mis-­ segregation rate, a measure of CIN, can inform prognosis and is a promising biomarker for response to anti-m­ icrotubule agents. However, existing methodologies to measure this rate are labor intensive, indirect, and confounded by selection against aneuploid cells, which reduces observable diversity. We developed a framework to measure CIN, accounting for karyotype selection, using simulations with various levels of CIN and models of selection. To identify the model parameters that best fit karyotype data from single-­cell sequencing, we used approximate Bayesian computation to infer mis-s­ egregation rates and karyotype selection. Experimental validation confirmed the extensive chromosome mis-s­ egregation rates caused by the chemotherapy paclitaxel (18.5 ± 0.5/division). Extending this approach to clinical samples revealed that inferred rates fell within direct observations of cancer cell lines. This work provides the necessary framework to quantify CIN in human tumors and develop it as a predictive biomarker.},
	language = {en},
	urldate = {2022-05-02},
	journal = {eLife},
	author = {Lynch, Andrew R. and Arp, Nicholas L and Zhou, Amber S and Weaver, Beth A and Burkard, Mark E},
	month = apr,
	year = {2022},
	pages = {e69799},
	file = {Lynch et al. - 2022 - Quantifying chromosomal instability from intratumoral karyotype diversity using agent-based modeling.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Lynch et al. - 2022 - Quantifying chromosomal instability from intratumoral karyotype diversity using agent-based modeling.pdf:application/pdf},
}

