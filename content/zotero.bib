Label: Cold Spring Harbor Laboratory Press
Publisher: Cold Spring Harbor Lab},
	pages = {a015776},
	file = {Wieser and Pines - 2015 - The Biochemistry of Mitosis.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Wieser and Pines - 2015 - The Biochemistry of Mitosis.pdf:application/pdf},
}

