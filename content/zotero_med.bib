	keywords = {Comparative Genomic Hybridization, High-Throughput Nucleotide Sequencing, Humans, Biopsy, Adult, Blastocyst, blastocyst biopsy, chromosomal rearrangements, Chromosome Disorders, Chromosomes, Human, Embryo Culture Techniques, Female, Genetic Markers, Hospitals, University, Male, Massive parallel sequencing, Predictive Value of Tests, Preimplantation Diagnosis, preimplantation genetic diagnosis, Sperm Injections, Intracytoplasmic, Translocation, Genetic, whole genome amplification},
	pages = {1276--1285.e1},
	file = {Deleye et al. - 2015 - Shallow whole genome sequencing is well suited for the detection of chromosomal aberrations in human.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Deleye et al. - 2015 - Shallow whole genome sequencing is well suited for the detection of chromosomal aberrations in human.pdf:application/pdf},
