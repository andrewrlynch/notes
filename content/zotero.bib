@article{liskovykh_novel_2019,
	title = {A novel assay to screen {siRNA} libraries identifies protein kinases required for chromosome transmission},
	volume = {29},
	issn = {1088-9051, 1549-5469},
	url = {https://genome.cshlp.org/content/29/10/1719},
	doi = {10.1101/gr.254276.119},
	abstract = {One of the hallmarks of cancer is chromosome instability (CIN), which leads to aneuploidy, translocations, and other chromosome aberrations. However, in the vast majority of human tumors the molecular basis of CIN remains unknown, partly because not all genes controlling chromosome transmission have yet been identified. To address this question, we developed an experimental high-throughput imaging (HTI) siRNA assay that allows the identification of novel CIN genes. Our method uses a human artificial chromosome (HAC) expressing the GFP transgene. When this assay was applied to screen an siRNA library of protein kinases, we identified PINK1, TRIO, IRAK1, PNCK, and TAOK1 as potential novel genes whose knockdown induces various mitotic abnormalities and results in chromosome loss. The HAC-based assay can be applied for screening different siRNA libraries (cell cycle regulation, DNA damage response, epigenetics, and transcription factors) to identify additional genes involved in CIN. Identification of the complete spectrum of CIN genes will reveal new insights into mechanisms of chromosome segregation and may expedite the development of novel therapeutic strategies to target the CIN phenotype in cancer cells.},
	language = {en},
	number = {10},
	urldate = {2023-02-16},
	journal = {Genome Research},
	author = {Liskovykh, Mikhail and Goncharov, Nikolay V. and Petrov, Nikolai and Aksenova, Vasilisa and Pegoraro, Gianluca and Ozbun, Laurent L. and Reinhold, William C. and Varma, Sudhir and Dasso, Mary and Kumeiko, Vadim and Masumoto, Hiroshi and Earnshaw, William C. and Larionov, Vladimir and Kouprina, Natalay},
	month = oct,
	year = {2019},
	pmid = {31515286},
	note = {Company: Cold Spring Harbor Laboratory Press
Distributor: Cold Spring Harbor Laboratory Press
Institution: Cold Spring Harbor Laboratory Press
Label: Cold Spring Harbor Laboratory Press
Publisher: Cold Spring Harbor Lab},
	pages = {1719--1732},
	file = {Liskovykh et al. - 2019 - A novel assay to screen siRNA libraries identifies protein kinases required for chromosome transmiss.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Liskovykh et al. - 2019 - A novel assay to screen siRNA libraries identifies protein kinases required for chromosome transmiss.pdf:application/pdf},
