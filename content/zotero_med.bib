@article{dhital_harnessing_2023,
	title = {Harnessing transcriptionally driven chromosomal instability adaptation to target therapy-refractory lethal prostate cancer},
	volume = {4},
	issn = {26663791},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666379123000290},
	doi = {10.1016/j.xcrm.2023.100937},
	abstract = {Metastatic prostate cancer (PCa) inevitably acquires resistance to standard therapy preceding lethality. Here, we unveil a chromosomal instability (CIN) tolerance mechanism as a therapeutic vulnerability of therapy-refractory lethal PCa. Through genomic and transcriptomic analysis of patient datasets, we ﬁnd that castration and chemotherapy-resistant tumors display the highest CIN and mitotic kinase levels. Functional genomics screening coupled with quantitative phosphoproteomics identify MASTL kinase as a survival vulnerability speciﬁc of chemotherapy-resistant PCa cells. Mechanistically, MASTL upregulation is driven by transcriptional rewiring mechanisms involving the non-canonical transcription factors androgen receptor splice variant 7 and E2F7 in a circuitry that restrains deleterious CIN and prevents cell death selectively in metastatic therapy-resistant PCa cells. Notably, MASTL pharmacological inhibition re-sensitizes tumors to standard therapy and improves survival of pre-clinical models. These results uncover a targetable mechanism promoting high CIN adaptation and survival of lethal PCa.},
	language = {en},
	number = {2},
	urldate = {2023-02-28},
	journal = {Cell Reports Medicine},
	author = {Dhital, Brittiny and Santasusagna, Sandra and Kirthika, Perumalraja and Xu, Michael and Li, Peiyao and Carceles-Cordon, Marc and Soni, Rajesh K. and Li, Zhuoning and Hendrickson, Ronald C. and Schiewer, Matthew J. and Kelly, William K. and Sternberg, Cora N. and Luo, Jun and Lujambio, Amaia and Cordon-Cardo, Carlos and Alvarez-Fernandez, Monica and Malumbres, Marcos and Huang, Haojie and Ertel, Adam and Domingo-Domenech, Josep and Rodriguez-Bravo, Veronica},
	month = feb,
