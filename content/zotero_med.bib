	keywords = {Aneuploidy, Cancer stem cells, Chromosomal instability, CIN, CNV, Copy number variation, CSCs, Glioblastoma, Heterogeneity},
	pages = {79},
	file = {Snapshot:/Users/andrew/Zotero/storage/GNXPEGQ6/s12920-019-0532-5.html:text/html;Zhao et al. - 2019 - Single-cell RNA sequencing reveals the impact of chromosomal instability on glioblastoma cancer stem.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Zhao et al. - 2019 - Single-cell RNA sequencing reveals the impact of chromosomal instability on glioblastoma cancer stem.pdf:application/pdf},
}

@article{dephoure_quantitative_2014,
	title = {Quantitative proteomic analysis reveals posttranslational responses to aneuploidy in yeast},
	volume = {3},
	issn = {2050-084X},
	url = {https://doi.org/10.7554/eLife.03023},
	doi = {10.7554/eLife.03023},
	abstract = {Aneuploidy causes severe developmental defects and is a near universal feature of tumor cells. Despite its profound effects, the cellular processes affected by aneuploidy are not well characterized. Here, we examined the consequences of aneuploidy on the proteome of aneuploid budding yeast strains. We show that although protein levels largely scale with gene copy number, subunits of multi-protein complexes are notable exceptions. Posttranslational mechanisms attenuate their expression when their encoding genes are in excess. Our proteomic analyses further revealed a novel aneuploidy-associated protein expression signature characteristic of altered metabolism and redox homeostasis. Indeed aneuploid cells harbor increased levels of reactive oxygen species (ROS). Interestingly, increased protein turnover attenuates ROS levels and this novel aneuploidy-associated signature and improves the fitness of most aneuploid strains. Our results show that aneuploidy causes alterations in metabolism and redox homeostasis. Cells respond to these alterations through both transcriptional and posttranscriptional mechanisms.},
	urldate = {2023-03-24},
	journal = {eLife},
	author = {Dephoure, Noah and Hwang, Sunyoung and O'Sullivan, Ciara and Dodgson, Stacie E and Gygi, Steven P and Amon, Angelika and Torres, Eduardo M},
	editor = {Dikic, Ivan},
	month = jul,
	year = {2014},
	note = {Publisher: eLife Sciences Publications, Ltd},
	keywords = {aneuploidy, posttranscriptional mechanism, posttranslational mechanism, proteomics},
	pages = {e03023},
	file = {Dephoure et al. - 2014 - Quantitative proteomic analysis reveals posttranslational responses to aneuploidy in yeast.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Dephoure et al. - 2014 - Quantitative proteomic analysis reveals posttranslational responses to aneuploidy in yeast.pdf:application/pdf},
}

