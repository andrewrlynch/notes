@article{whiting_phenotypic_2023,
	title = {Phenotypic noise and plasticity in cancer evolution},
	volume = {0},
	issn = {0962-8924, 1879-3088},
	url = {https://www.cell.com/trends/cell-biology/abstract/S0962-8924(23)00206-4},
	doi = {10.1016/j.tcb.2023.10.002},
	abstract = {{\textless}h2{\textgreater}Abstract{\textless}/h2{\textgreater}{\textless}p{\textgreater}Non-genetic alterations can produce changes in a cell's phenotype. In cancer, these phenomena can influence a cell's fitness by conferring access to heritable, beneficial phenotypes. Herein, we argue that current discussions of ‘phenotypic plasticity' in cancer evolution ignore a salient feature of the original definition: namely, that it occurs in response to an environmental change. We suggest ‘phenotypic noise' be used to distinguish non-genetic changes in phenotype that occur independently from the environment. We discuss the conceptual and methodological techniques used to identify these phenomena during cancer evolution. We propose that the distinction will guide efforts to define mechanisms of phenotype change, accelerate translational work to manipulate phenotypes through treatment, and, ultimately, improve patient outcomes.{\textless}/p{\textgreater}},
	language = {English},
	number = {0},
	urldate = {2023-11-30},
	journal = {Trends in Cell Biology},
	author = {Whiting, Frederick J. H. and Househam, Jacob and Baker, Ann-Marie and Sottoriva, Andrea and Graham, Trevor A.},
	month = nov,
	year = {2023},
	pmid = {37968225},
	note = {Publisher: Elsevier},
	file = {Whiting et al. - 2023 - Phenotypic noise and plasticity in cancer evolution.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Whiting et al. - 2023 - Phenotypic noise and plasticity in cancer evolution.pdf:application/pdf},
}

@article{williams_measuring_2020,
	title = {Measuring the distribution of fitness effects in somatic evolution by combining clonal dynamics with {dN}/{dS} ratios},
	volume = {9},
