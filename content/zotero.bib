	note = {Publisher: Nature Publishing Group},
	keywords = {Genomics, Cancer stem cells, Acute myeloid leukaemia},
	pages = {2790--2803},
	file = {Leppä et al. - 2024 - Single-cell multiomics analysis reveals dynamic clonal evolution and targetable phenotypes in acute.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Leppä et al. - 2024 - Single-cell multiomics analysis reveals dynamic clonal evolution and targetable phenotypes in acute.pdf:application/pdf},
