@article{xu_deep_2021,
	title = {Deep {Learning} {Predicts} {Chromosomal} {Instability} from {Histopathology} {Images}},
	issn = {2589-0042},
	doi = {10.1016/j.isci.2021.102394},
	abstract = {Chromosomal instability (CIN) is a hallmark of human cancer yet not readily testable for cancer patients in routine clinical setting. In this study, we sought to explore whether CIN status can be predicted using ubiquitously available hematoxylin and eosin (H\&E) histology through a deep learning-based model. When applied to a cohort of 1,010 breast cancer patients (Training set: n=858, Test set: n=152) from The Cancer Genome Atlas (TCGA) where 485 patients have high CIN status, our model accurately classified CIN status, achieving an area under the curve (AUC) of 0.822 with 81.2\% sensitivity and 68.7\% specificity in the test set. Patch-level predictions of CIN status suggested intra-tumor heterogeneity within slides. Moreover, presence of patches with high predicted CIN score within an entire slide was more predictive of clinical outcome than the average CIN score of the slide, thus underscoring the clinical importance of intra-tumor heterogeneity.},
	journal = {iScience},
	author = {Xu, Zhuoran and Verma, Akanksha and Naveed, Uska and Bakhoum, Samuel and Khosravi, Pegah and Elemento, Olivier},
	year = {2021},
	keywords = {Automation in Bioinformatics, Cancer Systems Biology, Cell Biology, Neural Networks},
	pages = {102394},
	file = {Full Text PDF:/Users/andrew/Zotero/storage/HF5LZF7Z/Xu et al. - 2021 - Deep learning predicts chromosomal instability fro.pdf:application/pdf;Xu et al. - 2021 - Deep Learning Predicts Chromosomal Instability from Histopathology Images 1.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Xu et al. - 2021 - Deep Learning Predicts Chromosomal Instability from Histopathology Images 1.pdf:application/pdf},
}

