	journal = {Cancer Cell},
	author = {Steele, Christopher D. and Tarabichi, Maxime and Oukrif, Dahmane and Webster, Amy P. and Ye, Hongtao and Fittall, Matthew and Lombard, Patrick and Martincorena, Iñigo and Tarpey, Patrick S. and Collord, Grace and Haase, Kerstin and Strauss, Sandra J. and Berisha, Fitim and Vaikkinen, Heli and Dhami, Pawan and Jansen, Marnix and Behjati, Sam and Amary, M. Fernanda and Tirabosco, Roberto and Feber, Andrew and Campbell, Peter J. and Alexandrov, Ludmil B. and Van Loo, Peter and Flanagan, Adrienne M. and Pillay, Nischalan},
