	keywords = {Humans, Polymorphism, Single Nucleotide, Biomarkers, Tumor, Biopsy, Carcinoma, Renal Cell, Chromosome Aberrations, Everolimus, Evolution, Molecular, Exome, Genetic Heterogeneity, Immunosuppressive Agents, Kidney, Kidney Neoplasms, Mutation, Neoplasm Metastasis, Phenotype, Phylogeny, Ploidies, Sequence Analysis, DNA, Sirolimus},
	pages = {883--892},
	file = {Gerlinger et al. - 2012 - Intratumor heterogeneity and branched evolution revealed by multiregion sequencing.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Gerlinger et al. - 2012 - Intratumor heterogeneity and branched evolution revealed by multiregion sequencing.pdf:application/pdf},
