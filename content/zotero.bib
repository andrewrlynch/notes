@article{vinci_functional_2018,
	title = {Functional diversity and cooperativity between subclonal populations of pediatric glioblastoma and diffuse intrinsic pontine glioma cells},
	volume = {24},
	issn = {1546170X},
	url = {http://www.nature.com/articles/s41591-018-0086-7},
	doi = {10.1038/s41591-018-0086-7},
	abstract = {The failure to develop effective therapies for pediatric glioblastoma (pGBM) and diffuse intrinsic pontine glioma (DIPG) is in part due to their intrinsic heterogeneity. We aimed to quantitatively assess the extent to which this was present in these tumors through subclonal genomic analyses and to determine whether distinct tumor subpopulations may interact to promote tumorigenesis by generating subclonal patient-derived models in vitro and in vivo. Analysis of 142 sequenced tumors revealed multiple tumor subclones, spatially and temporally coexisting in a stable manner as observed by multiple sampling strategies. We isolated genotypically and phenotypically distinct subpopulations that we propose cooperate to enhance tumorigenicity and resistance to therapy. Inactivating mutations in the H4K20 histone methyltransferase KMT5B (SUV420H1), present in 1 of cells, abrogate DNA repair and confer increased invasion and migration on neighboring cells, in vitro and in vivo, through chemokine signaling and modulation of integrins. These data indicate that even rare tumor subpopulations may exert profound effects on tumorigenesis as a whole and may represent a new avenue for therapeutic development. Unraveling the mechanisms of subclonal diversity and communication in pGBM and DIPG will be an important step toward overcoming barriers to effective treatments.},
	number = {8},
	journal = {Nature Medicine},
	author = {Vinci, Mara and Burford, Anna and Molinari, Valeria and Kessler, Ketty and Popov, Sergey and Clarke, Matthew and Taylor, Kathryn R. and Pemberton, Helen N. and Lord, Christopher J. and Gutteridge, Alice and Forshew, Tim and Carvalho, Diana and Marshall, Lynley V. and Qin, Elizabeth Y. and Ingram, Wendy J. and Moore, Andrew S. and Ng, Ho Keung and Trabelsi, Saoussen and Brahim, Dorra H'mida-Ben and Entz-Werle, Natacha and Zacharoulis, Stergios and Vaidya, Sucheta and Mandeville, Henry C. and Bridges, Leslie R. and Martin, Andrew J. and Al-Sarraj, Safa and Chandler, Christopher and Sunol, Mariona and Mora, Jaume and Torres, Carmen de and Cruz, Ofelia and Carcaboso, Angel M. and Monje, Michelle and Mackay, Alan and Jones, Chris},
	year = {2018},
	keywords = {Tumour heterogeneity, CNS cancer, Paediatric cancer},
	pages = {1204--1215},
