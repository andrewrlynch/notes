	keywords = {DNA Copy Number Variations, Genomics, High-Throughput Nucleotide Sequencing, Humans, Biomarkers, Tumor, Sequence Analysis, DNA, Female, Breast Neoplasms, Case-Control Studies, Copy number (CN) and breast cancer, DNA, Formaldehyde, Formalin-fixed paraffin-embedded (FFPE), Gene Expression Profiling, Neoplasm Invasiveness, Paraffin Embedding, Shallow whole genome sequencing (sWGS), Tissue Fixation, Whole Genome Sequencing},
	pages = {161--169},
