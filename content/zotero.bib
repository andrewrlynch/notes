	month = apr,
	year = {2021},
	keywords = {cancer evolution, branching evolution, cancer driver genes, intra-tumor heterogeneity, pan-cancer genomics, subclonal reconstruction, tumor phylogeny, whole-genome sequencing},
	pages = {2239--2254.e39},
	file = {Dentro et al. - 2021 - Characterizing genetic intra-tumor heterogeneity across 2,658 human cancer genomes.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Dentro et al. - 2021 - Characterizing genetic intra-tumor heterogeneity across 2,658 human cancer genomes.pdf:application/pdf},
