	number = {1},
	urldate = {2025-06-03},
	journal = {Nature Communications},
	author = {Jiang, Yafei and Wang, Jinzeng and Sun, Mengxiong and Zuo, Dongqing and Wang, Hongsheng and Shen, Jiakang and Jiang, Wenyan and Mu, Haoran and Ma, Xiaojun and Yin, Fei and Lin, Jun and Wang, Chongren and Yu, Shuting and Jiang, Lu and Lv, Gang and Liu, Feng and Xue, Linghang and Tian, Kai and Wang, Gangyang and Zhou, Zifei and Lv, Yu and Wang, Zhuoying and Zhang, Tao and Xu, Jing and Yang, Liu and Zhao, Kewen and Sun, Wei and Tang, Yujie and Cai, Zhengdong and Wang, Shengyue and Hua, Yingqi},
	month = nov,
