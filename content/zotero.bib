	month = apr,
	year = {2023},
	pmid = {37080200},
	note = {Publisher: Elsevier},
	pages = {2018--2034.e21},
	file = {Messner et al. - 2023 - The proteomic landscape of genome-wide genetic perturbations.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Messner et al. - 2023 - The proteomic landscape of genome-wide genetic perturbations.pdf:application/pdf},
