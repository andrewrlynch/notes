	pages = {848--853},
	file = {Stranger et al. - 2007 - Relative Impact of Nucleotide and Copy Number Variation on Gene Expression Phenotypes.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Stranger et al. - 2007 - Relative Impact of Nucleotide and Copy Number Variation on Gene Expression Phenotypes.pdf:application/pdf},
