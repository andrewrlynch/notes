	note = {Number: 5
Publisher: Nature Publishing Group},
	keywords = {Computational biology and bioinformatics, Genetics, Cancer},
	pages = {599--608},
	file = {Gao et al. - 2021 - Delineating copy number and clonal substructure in human tumors from single-cell transcriptomes 1.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Gao et al. - 2021 - Delineating copy number and clonal substructure in human tumors from single-cell transcriptomes 1.pdf:application/pdf;Gao et al. - 2021 - Delineating copy number and clonal substructure in human tumors from single-cell transcriptomes.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Gao et al. - 2021 - Delineating copy number and clonal substructure in human tumors from single-cell transcriptomes.pdf:application/pdf},
