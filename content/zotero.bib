	issn = {1471-0064},
	url = {https://www.nature.com/articles/s41576-021-00338-8},
	doi = {10.1038/s41576-021-00338-8},
	abstract = {Technological innovation and rapid reduction in sequencing costs have enabled the genomic profiling of hundreds of cancer-associated genes as a component of routine cancer care. Tumour genomic profiling can refine cancer subtype classification, identify which patients are most likely to benefit from systemic therapies and screen for germline variants that influence heritable cancer risk. Here, we discuss ongoing efforts to enhance the clinical utility of tumour genomic profiling by integrating tumour and germline analyses, characterizing allelic context and identifying mutational signatures that influence therapy response. We also discuss the potential clinical utility of more comprehensive whole-genome and whole-transcriptome sequencing and ultra-sensitive cell-free DNA profiling platforms, which allow for minimally invasive, serial analyses of tumour-derived DNA in blood.},
	language = {en},
	number = {8},
	urldate = {2024-11-22},
	journal = {Nature Reviews Genetics},
	author = {Chakravarty, Debyani and Solit, David B.},
	month = aug,
	year = {2021},
	note = {Publisher: Nature Publishing Group},
	keywords = {Cancer genomics, Cancer genetics, Genetic variation},
	pages = {483--501},
	file = {Chakravarty and Solit - 2021 - Clinical cancer genomic profiling.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Chakravarty and Solit - 2021 - Clinical cancer genomic profiling.pdf:application/pdf},
}

@article{fan_smooth-seq_2021,
	title = {{SMOOTH}-seq: single-cell genome sequencing of human cells on a third-generation sequencing platform},
	volume = {22},
	issn = {1474-760X},
	shorttitle = {{SMOOTH}-seq},
	url = {https://doi.org/10.1186/s13059-021-02406-y},
	doi = {10.1186/s13059-021-02406-y},
	abstract = {There is no effective way to detect structure variations (SVs) and extra-chromosomal circular DNAs (ecDNAs) at single-cell whole-genome level. Here, we develop a novel third-generation sequencing platform-based single-cell whole-genome sequencing (scWGS) method named SMOOTH-seq (single-molecule real-time sequencing of long fragments amplified through transposon insertion). We evaluate the method for detecting CNVs, SVs, and SNVs in human cancer cell lines and a colorectal cancer sample and show that SMOOTH-seq reliably and effectively detects SVs and ecDNAs in individual cells, but shows relatively limited accuracy in detection of CNVs and SNVs. SMOOTH-seq opens a new chapter in scWGS as it generates high fidelity reads of kilobases long.},
	language = {en},
	number = {1},
	urldate = {2024-11-22},
	journal = {Genome Biology},
	author = {Fan, Xiaoying and Yang, Cheng and Li, Wen and Bai, Xiuzhen and Zhou, Xin and Xie, Haoling and Wen, Lu and Tang, Fuchou},
	month = jun,
	year = {2021},
	keywords = {Extra-chromosomal circular DNAs, Single-cell genome sequencing, Single-molecule sequencing, Structure variants, Third-generation sequencing platform},
	pages = {195},
	file = {Fan et al. - 2021 - SMOOTH-seq single-cell genome sequencing of human cells on a third-generation sequencing platform.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Fan et al. - 2021 - SMOOTH-seq single-cell genome sequencing of human cells on a third-generation sequencing platform.pdf:application/pdf},
