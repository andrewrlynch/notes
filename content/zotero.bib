@article{setton_long-molecule_2023,
	title = {Long-molecule scars of backup {DNA} repair in {BRCA1}- and {BRCA2}-deficient cancers},
	copyright = {2023 The Author(s)},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-023-06461-2},
	doi = {10.1038/s41586-023-06461-2},
	abstract = {Homologous recombination (HR) deficiency is associated with DNA rearrangements and cytogenetic aberrations1. Paradoxically, the types of DNA rearrangements that are specifically associated with HR-deficient cancers only minimally affect chromosomal structure2. Here, to address this apparent contradiction, we combined genome-graph analysis of short-read whole-genome sequencing (WGS) profiles across thousands of tumours with deep linked-read WGS of 46 BRCA1- or BRCA2-mutant breast cancers. These data revealed a distinct class of HR-deficiency-enriched rearrangements called reciprocal pairs. Linked-read WGS showed that reciprocal pairs with identical rearrangement orientations gave rise to one of two distinct chromosomal outcomes, distinguishable only with long-molecule data. Whereas one (cis) outcome corresponded to the copying and pasting of a small segment to a distant site, a second (trans) outcome was a quasi-balanced translocation or multi-megabase inversion with substantial (10 kb) duplications at each junction. We propose an HR-independent replication-restart repair mechanism to explain the full spectrum of reciprocal pair outcomes. Linked-read WGS also identified single-strand annealing as a repair pathway that is specific to BRCA2 deficiency in human cancers. Integrating these features in a classifier improved discrimination between BRCA1- and BRCA2-deficient genomes. In conclusion, our data reveal classes of rearrangements that are specific to BRCA1 or BRCA2 deficiency as a source of cytogenetic aberrations in HR-deficient cells.},
	language = {en},
	urldate = {2023-08-16},
	journal = {Nature},
	author = {Setton, Jeremy and Hadi, Kevin and Choo, Zi-Ning and Kuchin, Katherine S. and Tian, Huasong and Da Cruz Paula, Arnaud and Rosiene, Joel and Selenica, Pier and Behr, Julie and Yao, Xiaotong and Deshpande, Aditya and Sigouros, Michael and Manohar, Jyothi and Nauseef, Jones T. and Mosquera, Juan-Miguel and Elemento, Olivier and Weigelt, Britta and Riaz, Nadeem and Reis-Filho, Jorge S. and Powell, Simon N. and Imieliński, Marcin},
	month = aug,
	year = {2023},
	note = {Publisher: Nature Publishing Group},
	keywords = {Breast cancer, Cancer genomics, DNA sequencing, Homologous recombination, Genome evolution},
	pages = {1--9},
	file = {Setton et al. - 2023 - Long-molecule scars of backup DNA repair in BRCA1- and BRCA2-deficient cancers.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Setton et al. - 2023 - Long-molecule scars of backup DNA repair in BRCA1- and BRCA2-deficient cancers.pdf:application/pdf},
}

@article{hung_ecdna_2021,
	title = {{ecDNA} hubs drive cooperative intermolecular oncogene expression},
	volume = {600},
	copyright = {2021 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-021-04116-8},
	doi = {10.1038/s41586-021-04116-8},
	abstract = {Extrachromosomal DNA (ecDNA) is prevalent in human cancers and mediates high expression of oncogenes through gene amplification and altered gene regulation1. Gene induction typically involves cis-regulatory elements that contact and activate genes on the same chromosome2,3. Here we show that ecDNA hubs—clusters of around 10–100 ecDNAs within the nucleus—enable intermolecular enhancer–gene interactions to promote oncogene overexpression. ecDNAs that encode multiple distinct oncogenes form hubs in diverse cancer cell types and primary tumours. Each ecDNA is more likely to transcribe the oncogene when spatially clustered with additional ecDNAs. ecDNA hubs are tethered by the bromodomain and extraterminal domain (BET) protein BRD4 in a MYC-amplified colorectal cancer cell line. The BET inhibitor JQ1 disperses ecDNA hubs and preferentially inhibits ecDNA-derived-oncogene transcription. The BRD4-bound PVT1 promoter is ectopically fused to MYC and duplicated in ecDNA, receiving promiscuous enhancer input to drive potent expression of MYC. Furthermore, the PVT1 promoter on an exogenous episome suffices to mediate gene activation in trans by ecDNA hubs in a JQ1-sensitive manner. Systematic silencing of ecDNA enhancers by CRISPR interference reveals intermolecular enhancer–gene activation among multiple oncogene loci that are amplified on distinct ecDNAs. Thus, protein-tethered ecDNA hubs enable intermolecular transcriptional regulation and may serve as units of oncogene function and cooperative evolution and as potential targets for cancer therapy.},
	language = {en},
	number = {7890},
	urldate = {2022-10-26},
	journal = {Nature},
	author = {Hung, King L. and Yost, Kathryn E. and Xie, Liangqi and Shi, Quanming and Helmsauer, Konstantin and Luebeck, Jens and Schöpflin, Robert and Lange, Joshua T. and Chamorro González, Rocío and Weiser, Natasha E. and Chen, Celine and Valieva, Maria E. and Wong, Ivy Tsz-Lo and Wu, Sihan and Dehkordi, Siavash R. and Duffy, Connor V. and Kraft, Katerina and Tang, Jun and Belk, Julia A. and Rose, John C. and Corces, M. Ryan and Granja, Jeffrey M. and Li, Rui and Rajkumar, Utkrisht and Friedlein, Jordan and Bagchi, Anindya and Satpathy, Ansuman T. and Tjian, Robert and Mundlos, Stefan and Bafna, Vineet and Henssen, Anton G. and Mischel, Paul S. and Liu, Zhe and Chang, Howard Y.},
	month = dec,
	year = {2021},
	note = {Number: 7890
Publisher: Nature Publishing Group},
	keywords = {Oncogenes, Tumour heterogeneity, ecDNA, Cancer epigenetics},
	pages = {731--736},
	file = {Hung et al. - 2021 - ecDNA hubs drive cooperative intermolecular oncogene expression.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Hung et al. - 2021 - ecDNA hubs drive cooperative intermolecular oncogene expression.pdf:application/pdf;Snapshot:/Users/andrew/Zotero/storage/2JFE66QR/s41586-021-04116-8.html:text/html;Submitted Version:/Users/andrew/Zotero/storage/QPZPFXWL/Hung et al. - 2021 - ecDNA hubs drive cooperative intermolecular oncoge.pdf:application/pdf},
}

@article{ng_rearrangement_2022,
	title = {Rearrangement processes and structural variations show evidence of selection in oesophageal adenocarcinomas},
	volume = {5},
	issn = {2399-3642},
	url = {https://www.nature.com/articles/s42003-022-03238-7},
	doi = {10.1038/s42003-022-03238-7},
	abstract = {Abstract
            
              Oesophageal adenocarcinoma (OAC) provides an ideal case study to characterize large-scale rearrangements. Using whole genome short-read sequencing of 383 cases, for which 214 had matched whole transcriptomes, we observed structural variations (SV) with a predominance of deletions, tandem duplications and inter-chromosome junctions that could be identified as LINE-1 mobile element (ME) insertions. Complex clusters of rearrangements resembling breakage-fusion-bridge cycles or extrachromosomal circular DNA accounted for 22\% of complex SVs affecting known oncogenes. Counting SV events affecting known driver genes substantially increased the recurrence rates of these drivers. After excluding fragile sites, we identified 51 candidate new drivers in genomic regions disrupted by SVs, including
              ETV5, KAT6B
              and
              CLTC. RUNX1
              was the most recurrently altered gene (24\%), with many deletions inactivating the RUNT domain but preserved the reading frame, suggesting an altered protein product. These findings underscore the importance of identification of SV events in OAC with implications for targeted therapies.},
	language = {en},
	number = {1},
	urldate = {2023-08-15},
	journal = {Communications Biology},
	author = {Ng, Alvin Wei Tian and Contino, Gianmarco and Killcoyne, Sarah and Devonshire, Ginny and Hsu, Ray and Abbas, Sujath and Su, Jing and Redmond, Aisling M. and Weaver, Jamie M. J. and Eldridge, Matthew D. and Tavaré, Simon and {Oesophageal Cancer Clinical and Molecular Stratification (OCCAMS) Consortium} and Grehan, Nicola and Nutzinger, Barbara and Fidziukiewicz, Elwira and Freeman, Adam and Smyth, Elizabeth C. and O’Donovan, Maria and Miremadi, Ahmad and Malhotra, Shalini and Tripathi, Monika and Cheah, Calvin and Coles, Hannah and Flint, Connor and Eldridge, Matthew and Secrier, Maria and Jammula, Sriganesh and Davies, Jim and Crichton, Charles and Carroll, Nick and Hardwick, Richard H. and Safranek, Peter and Hindmarsh, Andrew and Sujendran, Vijayendran and Hayes, Stephen J. and Ang, Yeng and Sharrocks, Andrew and Preston, Shaun R. and Bagwan, Izhar and Save, Vicki and Skipworth, Richard J. E. and Hupp, Ted R. and O’Neill, J. Robert and Tucker, Olga and Beggs, Andrew and Taniere, Philippe and Puig, Sonia and Underwood, Timothy J. and Walker, Robert C. and Grace, Ben L. and Lagergren, Jesper and Gossage, James and Davies, Andrew and Chang, Fuju and Mahadeva, Ula and Goh, Vicky and Ciccarelli, Francesca D. and Sanders, Grant and Berrisford, Richard and Chan, David and Cheong, Ed and Kumar, Bhaskar and Sreedharan, L. and Parsons, Simon L. and Soomro, Irshad and Kaye, Philip and Saunders, John and Lovat, Laurence and Haidry, Rehan and Scott, Michael and Sothi, Sharmila and Lishman, Suzy and Hanna, George B. and Peters, Christopher J. and Moorthy, Krishna and Grabowska, Anna and Turkington, Richard and McManus, Damian and Coleman, Helen and Petty, Russell D. and Bartlett, Freddie and Edwards, Paul A. W. and Fitzgerald, Rebecca C.},
	month = apr,
	year = {2022},
