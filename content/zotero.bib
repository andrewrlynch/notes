	month = dec,
	year = {2018},
	keywords = {cancer genomics, tumor evolution, prostate cancer, APOBEC, early-onset cancer, epigenetic risk-score, mutational processes, structural variants, tumor evolution prediction},
	pages = {996--1011.e8},
	file = {Gerhauser et al. - 2018 - Molecular Evolution of Early-Onset Prostate Cancer Identifies Molecular Risk Markers and Clinical Tr.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Gerhauser et al. - 2018 - Molecular Evolution of Early-Onset Prostate Cancer Identifies Molecular Risk Markers and Clinical Tr.pdf:application/pdf;ScienceDirect Snapshot:/Users/andrew/Zotero/storage/NJY98RR7/S1535610818304823.html:text/html},
