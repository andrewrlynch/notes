@article{diercks_orthogonal_2025,
	title = {An orthogonal {T7} replisome for continuous hypermutation and accelerated evolution in {E}. coli},
	volume = {389},
	url = {https://www.science.org/doi/10.1126/science.adp9583},
	doi = {10.1126/science.adp9583},
	abstract = {Systems that perform continuous hypermutation of designated genes without compromising the integrity of the host genome can substantially accelerate the evolution of new or enhanced protein functions. We describe an orthogonal DNA replication system in Escherichia coli based on the controlled expression of the replisome of bacteriophage T7 (T7-ORACLE). The system replicates circular plasmids that enable high transformation efficiencies and seamless integration into standard molecular biology workflows. Engineering of T7 DNA polymerase yielded variant proteins with mutation rates of 1.7 × 10−5 substitutions per base in vivo—100,000-fold above the genomic mutation rate. We demonstrated continuous evolution using the T7 replisome by expanding the substrate scope of TEM-1 β-lactamase and increasing activity 5000-fold against clinically relevant monobactam and cephalosporin antibiotics in less than 1 week.},
	number = {6760},
	urldate = {2025-08-27},
	journal = {Science},
	author = {Diercks, Christian S. and Sondermann, Philipp and Rong, Cynthia and Gillis, Thomas G. and Ban, Yahui and Wang, Celine and Dik, David A. and Schultz, Peter G.},
	month = aug,
	year = {2025},
	pages = {618--622},
	file = {Diercks et al. - 2025 - An orthogonal T7 replisome for continuous hypermutation and accelerated evolution in E. coli.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/00 To Read/Diercks et al. - 2025 - An orthogonal T7 replisome for continuous hypermutation and accelerated evolution in E. coli.pdf:application/pdf},
}

