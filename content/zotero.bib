@article{yang_practical_2020,
	title = {A {Practical} {Guide} for {Structural} {Variation} {Detection} in the {Human} {Genome}},
	volume = {107},
	issn = {1934-8258},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cphg.103},
	doi = {10.1002/cphg.103},
	abstract = {Profiling genetic variants—including single nucleotide variants, small insertions and deletions, copy number variations, and structural variations (SVs)—from both healthy individuals and individuals with disease is a key component of genetic and biomedical research. SVs are large-scale changes in the genome and involve breakage and rejoining of DNA fragments. They may affect thousands to millions of nucleotides and can lead to loss, gain, and reshuffling of genes and regulatory elements. SVs are known to impact gene expression and potentially result in altered phenotypes and diseases. Therefore, identifying SVs from the human genomes is particularly important. In this review, I describe advantages and disadvantages of the available high-throughput assays for the discovery of SVs, which are the most challenging genetic alterations to detect. A practical guide is offered to suggest the most suitable strategies for discovering different types of SVs including common germline, rare, somatic, and complex variants. I also discuss factors to be considered, such as cost and performance, for different strategies when designing experiments. Last, I present several approaches to identify potential SV artifacts caused by samples, experimental procedures, and computational analysis. © 2020 Wiley Periodicals LLC.},
	language = {en},
	number = {1},
	urldate = {2022-10-25},
	journal = {Current Protocols in Human Genetics},
	author = {Yang, Lixing},
	year = {2020},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/cphg.103},
	keywords = {chromothripsis, genomic rearrangements, next-generation sequencing, single-molecule sequencing},
	pages = {e103},
	file = {Snapshot:/Users/andrew/Zotero/storage/AGAEQW4S/cphg.html:text/html;Yang - 2020 - A Practical Guide for Structural Variation Detection in the Human Genome.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Yang - 2020 - A Practical Guide for Structural Variation Detection in the Human Genome.pdf:application/pdf},
}

