@article{forni_trabectedin_2009,
	title = {Trabectedin ({ET}-743) promotes differentiation in myxoid liposarcoma tumors},
	volume = {8},
	issn = {1535-7163},
	url = {https://doi.org/10.1158/1535-7163.MCT-08-0848},
	doi = {10.1158/1535-7163.MCT-08-0848},
	abstract = {Differentiation is a complex set of events that can be blocked by rearrangements of regulatory genes producing fusion proteins with altered properties. In the case of myxoid liposarcoma (MLS) tumors, the causative abnormality is a fusion between the CHOP transcription factor and the FUS or EWS genes. CHOP belongs to and is a negative regulator of the large CAAT/enhancer binding protein family whose α, β,and δ members are master genes of adipogenesis. Recent clinical data indicate a peculiar sensitivity of these tumors to the natural marine compound trabectedin. One hypothesis is that the activity of trabectedin is related to the inactivation of the FUS-CHOP oncogene. We find that trabectedin causes detachment of the FUS-CHOP chimera from targeted promoters. Reverse transcription-PCR and chromatin immunoprecipitation analysis in a MLS line and surgical specimens of MLS patients in vivo show activation of the CAAT/enhancer binding protein–mediated transcriptional program that leads to morphologic changes of terminal adipogenesis. The activity is observed in cells with type 1 but not type 8 fusions. Hence, the drug induces maturation of MLS lipoblasts in vivo by targeting the FUS-CHOP–mediated transcriptional block. These data provide a rationale for the specific activity of trabectedin and open the perspective of combinatorial treatments with drugs acting on lipogenic pathways. [Mol Cancer Ther 2009;8(2):449–57]},
	number = {2},
	urldate = {2025-10-14},
	journal = {Molecular Cancer Therapeutics},
	author = {Forni, Claudia and Minuzzo, Mario and Virdis, Emanuela and Tamborini, Elena and Simone, Matteo and Tavecchio, Michele and Erba, Eugenio and Grosso, Federica and Gronchi, Alessandro and Aman, Pierre and Casali, Paolo and D'Incalci, Maurizio and Pilotti, Silvana and Mantovani, Roberto},
	month = feb,
	year = {2009},
	pages = {449--457},
	file = {Forni et al. - 2009 - Trabectedin (ET-743) promotes differentiation in myxoid liposarcoma tumors.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Forni et al. - 2009 - Trabectedin (ET-743) promotes differentiation in myxoid liposarcoma tumors.pdf:application/pdf;Snapshot:/Users/andrew/Zotero/storage/IZGKUR54/1535-7163.html:text/html},
}

