	keywords = {Cancer genomics, Paediatric cancer, ecDNA, Epigenomics},
	pages = {5823},
	file = {Helmsauer et al. - 2020 - Enhancer hijacking determines extrachromosomal circular MYCN amplicon architecture in neuroblastoma 1.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Helmsauer et al. - 2020 - Enhancer hijacking determines extrachromosomal circular MYCN amplicon architecture in neuroblastoma 1.pdf:application/pdf;Helmsauer et al. - 2020 - Enhancer hijacking determines extrachromosomal circular MYCN amplicon architecture in neuroblastoma.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Helmsauer et al. - 2020 - Enhancer hijacking determines extrachromosomal circular MYCN amplicon architecture in neuroblastoma.pdf:application/pdf},
