	keywords = {Humans, Neoplasms, Mutation, Female, Male, In Situ Hybridization, Fluorescence, Nucleic Acid Hybridization, Tumor Cells, Cultured, DNA Probes, DNA, Neoplasm, Fluorescent Dyes, Gene Amplification, Chromosome Mapping, Fluorescein-5-isothiocyanate, Rhodamines, Gene Deletion, Oncogenes, Polymorphism, Restriction Fragment Length},
