	url = {https://doi.org/10.1021/acs.jpcb.0c06954},
	doi = {10.1021/acs.jpcb.0c06954},
	abstract = {Chromosomal fragile sites (CFSs) contain AT-rich sequences that tend to form hairpins on lagging strands in DNA replication, making them hotspots for chromosomal rearrangements in cancers. Here, we investigate the structural stability of the AT-rich CFS DNA hairpins with a single non-AT base pair using magnetic tweezers. Strikingly, a single G-T mismatched base pair in the short CFS DNA hairpin gives a 38.7\% reduction of the unfolding Gibbs free energy and a 100-fold increase of the transition kinetics compared to a single G-C matched base pair, which are deviated from the theoretical simulations. Our study reveals the unique features of CFSs to provide profound insights into chromosomal instability and structure-specific genome targeting therapeutics for genetic disorder-related diseases.},
	number = {42},
	urldate = {2023-12-21},
	journal = {The Journal of Physical Chemistry B},
	author = {Li, Xiong and Pei, Yufeng and Zhang, Yashuo and Liu, Yajun and Fu, Wenhao and Li, Jixi and You, Huijuan and Huang, Jinqing},
	month = oct,
	year = {2020},
	note = {Publisher: American Chemical Society},
	pages = {9365--9370},
	file = {Li et al. - 2020 - Single-Molecule Mechanical Unfolding of AT-Rich Chromosomal Fragile Site DNA Hairpins Resolving the.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Li et al. - 2020 - Single-Molecule Mechanical Unfolding of AT-Rich Chromosomal Fragile Site DNA Hairpins Resolving the.pdf:application/pdf},
}

