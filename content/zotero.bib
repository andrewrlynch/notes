@misc{sankarGeneticElementsPromote2025,
	title = {Genetic elements promote retention of extrachromosomal {DNA} in cancer cells},
	copyright = {© 2025, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution 4.0 International), CC BY 4.0, as described at http://creativecommons.org/licenses/by/4.0/},
	url = {https://www.biorxiv.org/content/10.1101/2025.10.10.681495v1},
	doi = {10.1101/2025.10.10.681495},
	abstract = {Extrachromosomal DNA (ecDNA) is a prevalent and devastating form of oncogene amplification in cancer1,2. Circular megabase-sized ecDNAs lack centromeres and segregate stochastically during cell division3–6 yet persist over many generations. EcDNAs were first observed to hitchhike on mitotic chromosomes into daughter cell nuclei over 40 years ago with unknown mechanism3,7. Here we identify a family of human genomic elements, termed retention elements, that tether episomes to mitotic chromosomes to increase ecDNA transmission to daughter cells. We develop Retain-seq, a genome-scale assay that reveals thousands of human retention elements conferring generational persistence to heterologous episomes. Retention elements comprise a select set of CpG-rich gene promoters and act additively. Live-cell imaging and chromatin conformation capture show that retention elements physically interact with mitotic chromosomes at regions which are mitotically bookmarked by transcription factors and chromatin proteins, intermolecularly recapitulating promoter-enhancer interactions. Multiple retention elements are co-amplified with oncogenes on individual ecDNAs in human cancers and shape their sizes and structures. CpG-rich retention elements are focally hypomethylated; targeted cytosine methylation abrogates retention activity and leads to ecDNA loss, suggesting that methylation-sensitive interactions modulate episomal DNA retention. These results highlight the DNA elements and regulatory logic of mitotic ecDNA retention. Amplifications of retention elements promote the maintenance of oncogenic ecDNA across generations of cancer cells, revealing the principles of episome immortality intrinsic to the human genome.},
	language = {en},
	urldate = {2025-10-21},
	publisher = {bioRxiv},
	author = {Sankar, Venkat and Hung, King L. and Gnanasekar, Aditi and Wong, Ivy Tsz-Lo and Shi, Quanming and Kraft, Katerina and Jones, Matthew G. and He, Britney Jiayu and Yan, Xiaowei and Belk, Julia A. and Liu, Kevin J. and Agarwal, Sangya and Wang, Sean K. and Henssen, Anton G. and Mischel, Paul S. and Chang, Howard Y.},
	month = oct,
	year = {2025},
	note = {ISSN: 2692-8205
Pages: 2025.10.10.681495
Section: New Results},
	file = {Sankar et al. - 2025 - Genetic elements promote retention of extrachromosomal DNA in cancer cells.pdf:/Users/andrew/Library/Mobile Documents/com~apple~CloudDocs/Zotero Library/Sankar et al. - 2025 - Genetic elements promote retention of extrachromosomal DNA in cancer cells.pdf:application/pdf},
}

@article{wei_kras_2025,
	title = {{KRAS} {Inhibition} {Activates} an {Actionable} {CD24} "{Don}'t {Eat} {Me}" {Signal} in {Pancreatic} {Cancer}},
	issn = {1538-7445},
	doi = {10.1158/0008-5472.CAN-25-2024},
	abstract = {KRASG12C inhibitors (G12Ci) have produced encouraging, albeit modest and transient, clinical benefit in pancreatic ductal adenocarcinoma (PDAC). Identifying and targeting resistance mechanisms to G12Ci treatment is therefore crucial. To better understand the function of KRASG12C and possible G12Ci bypass mechanisms, we developed an autochthonous KRASG12C-driven PDAC model. Compared to the classical KRASG12D PDAC model, the G12C model exhibits slower tumor growth, yet similar histopathological and molecular features. Aligned with clinical experience, G12Ci treatment of KRASG12C tumors produced modest impact despite stimulating a 'hot' tumor immune microenvironment. Immunoprofiling revealed that CD24, a 'don't eat me' signal, is significantly upregulated on cancer cells upon G12Ci treatment. Blocking CD24 enhanced macrophage phagocytosis of cancer cells and significantly sensitized tumors to G12Ci treatment. Similar findings were observed in KRASG12D-driven PDAC. Together, this study reveals common and distinct oncogenic KRAS allele-specific biology and identifies a clinically actionable adaptive mechanism that may improve the efficacy of oncogenic KRAS inhibitor therapy in PDAC.},
	language = {eng},
	journal = {Cancer Research},
	author = {Wei, Yongkun and Liu, Minghui and Yen, Er-Yen and Yao, Jun and Xun, Zhenzhen and Nguyen, Phuoc T. and Wang, Xiaofei and Yang, Zecheng and Yousef, Abdelrahman and Pan, Dean and Jin, Yanqing and Li, Ching-Fei and Theardy, Madelaine S. and Park, Jangho and Cai, Yiming and Takeda, Mitsunobu and Vasquez, Matthew and Park, Elizabeth M. and Peng, David H. and Zhou, Yong and Zhao, Hong and Heffernan, Timothy P. and Viale, Andrea and Wang, Huamin and Watowich, Stephanie S. and Liang, Han and Zhao, Dan and DePinho, Ronald A. and Yao, Wantong and Ying, Haoqiang},
	month = sep,
	year = {2025},
